# Local development must use the isolated Development branch, never production.
# VERCEL_ENV is supplied by Vercel; do not set it to production locally.
POSTGRES_PRISMA_URL="postgresql://<db-user>:<db-password>@<db-host>/<db-name>?sslmode=require&connect_timeout=15&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://<db-user>:<db-password>@<db-host>/<db-name>?sslmode=require"
JWT_SECRET="<generate-a-long-random-secret>"
ADMIN_USER="<admin-email-or-username>"
ADMIN_PASSWORD="<strong-admin-password>"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
BLOB_READ_WRITE_TOKEN=""
# Exact public store hostname, without https:// or trailing slash.
BLOB_PUBLIC_HOSTNAME=""
